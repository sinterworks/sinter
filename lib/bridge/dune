(library
 (name sinter_bridge)
 (public_name sinter.bridge)
 (foreign_stubs
  (language c)
  (names bridge_stubs)
  (extra_deps sinter_bridge.h))
 (foreign_archives sinter_bridge)
 (c_library_flags
  (:include link_flags.sexp))
 (modes native)
 (instrumentation
  (backend bisect_ppx))
 (instrumentation
  (backend mutaml)))

; @cites bridge-build-folders
; Cargo's build output stays outside _build, in one directory for each
; content hash of the crate. build.sh runs ../cargo-build.sh to choose,
; seed, mark, and prune those directories; the second argument below is
; the directory to use when the environment names none.

(rule
 (targets libsinter_bridge.a link_flags.sexp)
 (deps
  build.sh
  ../cargo-build.sh
  (source_tree %{workspace_root}/bridge))
 (action
  (run
   ./build.sh
   %{workspace_root}/bridge
   rust-target
   libsinter_bridge.a
   link_flags.sexp)))

(rule
 (target sinter_bridge.h)
 (action
  (copy %{workspace_root}/bridge/include/sinter_bridge.h sinter_bridge.h)))
